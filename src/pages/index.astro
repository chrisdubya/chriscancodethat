---
import Base from "../layouts/Base.astro";
import GlobeScene from "../components/globe/GlobeScene.tsx";
import { cities, awards, contact } from "../data/resume";
import { buildProfilePageJsonLd } from "../lib/structuredData";

const jsonLd = buildProfilePageJsonLd();
---
<Base bodyClass="is-home">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>
  <div class="gl-root">
    <GlobeScene client:only="react" />
  </div>

  <!-- Static, crawlable résumé for SEO / no-WebGL fallback -->
  <main class="seo-fallback">
    <h1>{contact.name} — {contact.role}</h1>
    <p>{contact.location} · {contact.email} · {contact.phone}</p>
    {cities.map((city) => (
      <section>
        <h2>{city.label}</h2>
        <ul>
          {city.companies.map((c) => (
            <li>
              <h3>{c.name} — {c.title} ({c.dates})</h3>
              <p>{c.summary}</p>
              <p>{c.tech.join(", ")}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section>
      <h2>Awards</h2>
      <ul>{awards.map((a) => <li>{a.title} — {a.detail}</li>)}</ul>
    </section>
  </main>
</Base>
